# --- CLI: install-service / uninstall-service (systemd user unit) ---


def _systemd_user_unit_path() -> Path:
    return Path.home() / ".config" / "systemd" / "user" / SERVICE_NAME


def _resolve_self_path() -> Path:
    """Absolute path to this script (stable ExecStart target)."""
    return Path(os.path.realpath(sys.argv[0])).resolve()


def _systemctl_user(*args: str, check: bool = True) -> subprocess.CompletedProcess:
    cmd = ["systemctl", "--user", *args]
    return subprocess.run(cmd, check=check, capture_output=True, text=True)


def _build_unit_text(
    script: Path,
    host: str,
    port: int,
    api_key: str | None,
    model: str,
    auth_file: str | None,
) -> str:
    # Prefer the stable python3 executable found on PATH over a versioned
    # interpreter target that package-manager upgrades may remove.
    python = shutil.which("python3") or sys.executable
    exec_parts = [python, str(script), "serve", "--host", host, "--port", str(port)]
    if model:
        exec_parts.extend(["--model", model])
    if api_key:
        exec_parts.extend(["--api-key", api_key])
    if auth_file:
        exec_parts.extend(["--auth-file", auth_file])
    # systemd has its own command-line parser and expands both specifiers and
    # environment markers even inside quotes. Quote every argument and escape
    # those expansions so paths/keys containing spaces, %, $, or quotes work.
    def quote(value: str) -> str:
        escaped = (value.replace("\\", "\\\\")
                        .replace('"', '\\"')
                        .replace("%", "%%")
                        .replace("$", "$$")
                        .replace("\n", "\\n")
                        .replace("\r", "\\r")
                        .replace("\t", "\\t"))
        return f'"{escaped}"'

    exec_start = " ".join(quote(p) for p in exec_parts)
    return f"""[Unit]
Description=xgroxy — local OpenAI-compatible Grok API (X Premium+)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart={exec_start}
Restart=on-failure
RestartSec=5
# Keep auth files and any credentials in the unit private to this user.
UMask=0077

[Install]
WantedBy=default.target
"""


def cmd_install_service(args: argparse.Namespace) -> None:
    if not shutil.which("systemctl"):
        print("systemctl not found — systemd user services are not available.", file=sys.stderr)
        print("Start manually at login, e.g. add to your shell profile:", file=sys.stderr)
        print(f"  {sys.executable} {_resolve_self_path()} serve >/tmp/xgroxy.log 2>&1 &", file=sys.stderr)
        sys.exit(1)

    # Warn if not logged in yet (service can still install)
    entry = read_auth(args.auth_file)
    if not entry:
        path = _auth_file_path(args.auth_file)
        print(f"Note: no auth at {path} yet. Run 'xgroxy login' before expecting requests to work.")

    script = _resolve_self_path()
    unit_path = _systemd_user_unit_path()
    unit_path.parent.mkdir(parents=True, exist_ok=True)
    auth_file = str(_auth_file_path(args.auth_file).resolve()) if args.auth_file else None
    api_key = args.api_key or os.environ.get("XGROXY_API_KEY")
    if args.host not in ("127.0.0.1", "::1", "localhost") and not api_key:
        print("WARNING: non-loopback host without --api-key exposes the proxy to the network.",
              file=sys.stderr)
    text = _build_unit_text(
        script=script,
        host=args.host,
        port=args.port,
        api_key=api_key,
        model=args.model or DEFAULT_MODEL,
        auth_file=auth_file,
    )
    unit_path.write_text(text, encoding="utf-8")
    os.chmod(unit_path, 0o600)
    print(f"Wrote {unit_path}")

    try:
        _systemctl_user("daemon-reload")
        _systemctl_user("enable", "--now", SERVICE_NAME)
    except subprocess.CalledProcessError as e:
        print(e.stderr or e.stdout or str(e), file=sys.stderr)
        print(f"Unit written but enable/start failed. Try:\n  systemctl --user enable --now {SERVICE_NAME}", file=sys.stderr)
        sys.exit(1)

    # Linger so the service survives logout (optional; best-effort)
    if args.linger:
        try:
            user = os.environ.get("USER")
            if not user:
                raise RuntimeError("USER is not set")
            linger = subprocess.run(
                ["loginctl", "enable-linger", user],
                check=False, capture_output=True, text=True,
            )
            if linger.returncode != 0:
                print(f"Warning: could not enable linger: {(linger.stderr or linger.stdout).strip()}",
                      file=sys.stderr)
        except FileNotFoundError:
            print("Warning: loginctl not found; linger was not enabled.", file=sys.stderr)
        except RuntimeError as e:
            print(f"Warning: linger was not enabled: {e}", file=sys.stderr)

    st = _systemctl_user("is-active", SERVICE_NAME, check=False)
    active = (st.stdout or "").strip()
    print(f"Service:  {SERVICE_NAME} ({active or 'unknown'})")
    print(f"Endpoint: http://{args.host}:{args.port}/v1")
    print(f"Logs:     journalctl --user -u {SERVICE_NAME} -f")
    print(f"Stop:     systemctl --user stop {SERVICE_NAME}")
    print(f"Disable:  xgroxy uninstall-service")


def cmd_uninstall_service(args: argparse.Namespace) -> None:
    unit_path = _systemd_user_unit_path()
    if shutil.which("systemctl"):
        _systemctl_user("disable", "--now", SERVICE_NAME, check=False)
    if unit_path.exists():
        unit_path.unlink()
        print(f"Removed {unit_path}")
    else:
        print(f"No unit at {unit_path}")
    if shutil.which("systemctl"):
        _systemctl_user("daemon-reload", check=False)
        _systemctl_user("reset-failed", SERVICE_NAME, check=False)
    print("xgroxy will no longer start at login.")


# --- HTTP server ---


class _OpenAIError(Exception):
    def __init__(self, status: int, message: str, err_type: str = "server_error", code: str = ""):
        self.status = status
        self.message = message
        self.err_type = err_type
        self.code = code


def _scrub_message(msg: dict) -> dict:
    """Remove reasoning_content from messages (xAI rejects it)."""
    cleaned = {k: v for k, v in msg.items() if k != "reasoning_content"}
    return cleaned


def _forward_fields(body: dict, default_model: str = DEFAULT_MODEL) -> dict:
    """Extract only the fields we forward to the upstream."""
    allowed = {
        "model", "messages", "stream", "tools", "tool_choice",
        "temperature", "top_p", "max_tokens", "max_completion_tokens",
        "stop", "presence_penalty", "frequency_penalty", "seed",
        "response_format", "n", "parallel_tool_calls", "logprobs",
        "top_logprobs", "service_tier", "user", "reasoning_effort",
    }
    result = {}
    for k in allowed:
        if k in body:
            result[k] = body[k]
    if "model" not in result:
        result["model"] = default_model
    if "messages" in result:
        result["messages"] = [_scrub_message(m) for m in result["messages"]]
    if "stream_options" in body:
        result["stream_options"] = body["stream_options"]
    return result


def _upstream_request(body: dict, token: str) -> tuple[int, dict, dict]:
    """Make a non-streaming chat request. Returns (status, json_body, headers_dict)."""
    data = json.dumps(body).encode("utf-8")
    req = urllib.request.Request(UPSTREAM_CHAT_URL, data=data, method="POST")
    req.add_header("Content-Type", "application/json")
    req.add_header("Authorization", f"Bearer {token}")
    try:
        with urllib.request.urlopen(req, timeout=300) as resp:
            body = resp.read().decode("utf-8", errors="replace")
            try:
                parsed = json.loads(body)
            except json.JSONDecodeError:
                parsed = {"error": {"message": body[:500]}}
            return resp.status, parsed, dict(resp.headers)
    except urllib.error.HTTPError as e:
        try:
            resp_body = e.read().decode("utf-8", errors="replace")
            try:
                return e.code, json.loads(resp_body), dict(e.headers or {})
            except json.JSONDecodeError:
                return e.code, {"error": {"message": resp_body}}, dict(e.headers or {})
        finally:
            e.close()
    except (urllib.error.URLError, TimeoutError, OSError) as e:
        reason = getattr(e, "reason", e)
        return 502, {"error": {"message": f"Could not connect to xAI: {reason}"}}, {}


def _error_json(status: int, message: str, err_type: str = "server_error", code: str = ""):
    return status, {"error": {"message": message, "type": err_type, "code": code or str(status)}}


def _extract_error_message(upstream) -> str:
    """Pull a human-readable message out of an upstream error response."""
    if isinstance(upstream, dict):
        err = upstream.get("error")
        if isinstance(err, dict) and err.get("message"):
            return err["message"]
        if err:
            return str(err)
        if upstream.get("message"):
            return upstream["message"]
        return str(upstream)
    return str(upstream)


# SSE rewriting helpers


def _openai_sse_event(data: dict) -> bytes:
    return f"data: {json.dumps(data)}\n\n".encode("utf-8")


def _rewrite_sse_chunk(event_obj: dict, include_usage: bool) -> bytes | None:
    """Rewrite an xAI SSE event object into OpenAI shape. Returns bytes or None."""
    choices = event_obj.get("choices", [])
    if not choices:
        if include_usage and "usage" in event_obj:
            chunk = {
                "id": event_obj.get("id", ""),
                "object": "chat.completion.chunk",
                "created": event_obj.get("created", 0),
                "model": event_obj.get("model", DEFAULT_MODEL),
                "choices": [],
                "usage": event_obj["usage"],
            }
            return _openai_sse_event(chunk)
        return None

    rewritten_choices = []
    for choice in choices:
        delta = choice.get("delta", {})
        out_delta = {}

        # Preserve standard streaming fields clients use to construct the
        # final message, plus xAI's reasoning extension.
        for field in ("role", "content", "refusal", "reasoning_content"):
            if field in delta:
                out_delta[field] = delta[field]

        if "tool_calls" in delta:
            tc_list = []
            for tc in delta["tool_calls"]:
                otc = {"index": tc.get("index", 0)}
                if "id" in tc:
                    otc["id"] = tc["id"]
                if "function" in tc:
                    func = {}
                    if "name" in tc["function"]:
                        func["name"] = tc["function"]["name"]
                    if "arguments" in tc["function"]:
                        func["arguments"] = tc["function"]["arguments"]
                    if func:
                        otc["function"] = func
                if "type" in tc:
                    otc["type"] = tc["type"]
                tc_list.append(otc)
            out_delta["tool_calls"] = tc_list

        rewritten_choices.append({
            "index": choice.get("index", 0),
            "delta": out_delta,
            "finish_reason": choice.get("finish_reason"),
        })

    chunk = {
        "id": event_obj.get("id", ""),
        "object": "chat.completion.chunk",
        "created": event_obj.get("created", 0),
        "model": event_obj.get("model", DEFAULT_MODEL),
        "choices": rewritten_choices,
    }

    if "usage" in event_obj and include_usage:
        chunk["usage"] = event_obj["usage"]

    return _openai_sse_event(chunk)


# --- HTTP request handler ---


class _Handler(http.server.BaseHTTPRequestHandler):

    protocol_version = "HTTP/1.1"
    api_key: str | None = None
    auth_file_path: str | None = None
    default_model: str = DEFAULT_MODEL

    def _read_body(self) -> dict:
        raw_length = self.headers.get("Content-Length")
        if raw_length is None:
            self.close_connection = True
            self._send_error(411, "Content-Length header is required", "invalid_request_error")
            raise _OpenAIError(411, "missing content length")
        try:
            length = int(raw_length)
        except ValueError:
            self.close_connection = True
            self._send_error(400, "Invalid Content-Length header", "invalid_request_error")
            raise _OpenAIError(400, "bad content length")
        if length < 0:
            self.close_connection = True
            self._send_error(400, "Invalid Content-Length header", "invalid_request_error")
            raise _OpenAIError(400, "bad content length")
        if length > MAX_BODY:
            self.close_connection = True
            self._send_error(413, "Request body too large", "invalid_request_error")
            raise _OpenAIError(413, "too large")
        raw = self.rfile.read(length)
        try:
            parsed = json.loads(raw.decode("utf-8"))
        except (json.JSONDecodeError, UnicodeDecodeError):
            self._send_error(400, "Invalid JSON in request body", "invalid_request_error")
            raise _OpenAIError(400, "bad json")
        if not isinstance(parsed, dict):
            self._send_error(400, "Request body must be a JSON object", "invalid_request_error")
            raise _OpenAIError(400, "non-object json")
        return parsed

    def _check_api_key(self) -> bool:
        if self.api_key is None:
            return True
        auth = self.headers.get("Authorization", "")
        if hmac.compare_digest(auth.encode("utf-8"),
                               f"Bearer {self.api_key}".encode("utf-8")):
            return True
        self._send_error(401, "Missing or invalid API key", "authentication_error")
        return False

    def _send_error(self, status: int, message: str, err_type: str = "server_error",
                    code: str = "", extra_headers: dict | None = None):
        body = json.dumps({"error": {"message": message, "type": err_type,
                                     "code": code or str(status)}}).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        if extra_headers:
            for k, v in extra_headers.items():
                if v:
                    self.send_header(k, v)
        self._cors_headers()
        self.end_headers()
        self.wfile.write(body)

    def _cors_headers(self):
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "Authorization, Content-Type")

    def _send_json(self, status: int, data: dict):
        body = json.dumps(data).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self._cors_headers()
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, format, *args):
        # Suppress default stderr logging
        pass

    # --- Routing ---

    def do_OPTIONS(self):
        self.send_response(204)
        self._cors_headers()
        self.send_header("Content-Length", "0")
        self.end_headers()

    def do_GET(self):
        path = urllib.parse.urlsplit(self.path).path
        if path == "/health":
            self._handle_health()
        elif path == "/v1/models":
            self._handle_models()
        else:
            self._handle_404()

    def do_POST(self):
        path = urllib.parse.urlsplit(self.path).path
        if path == "/v1/chat/completions":
            self._handle_chat()
        else:
            self._handle_404()

    def _handle_404(self):
        self._send_error(404, "Not found", "invalid_request_error")

    def _handle_health(self):
        if not self._check_api_key():
            return
        try:
            entry = read_auth(self.auth_file_path)
        except Exception:
            entry = {}
        self._send_json(200, {
            "status": "ok",
            "email": entry.get("email", ""),
            "token_expires_at": entry.get("expires_at", ""),
        })

    def _handle_models(self):
        if not self._check_api_key():
            return
        self._send_json(200, {
            "object": "list",
            "data": [
                {"id": self.default_model, "object": "model",
                 "created": 0, "owned_by": "xai"},
            ],
        })

    def _handle_chat(self):
        if not self._check_api_key():
            return

        try:
            body = self._read_body()
        except _OpenAIError:
            return

        messages = body.get("messages")
        if not isinstance(messages, list) or not all(isinstance(m, dict) for m in messages):
            self._send_error(400, "'messages' must be an array of objects",
                             "invalid_request_error")
            return
        if "stream" in body and not isinstance(body["stream"], bool):
            self._send_error(400, "'stream' must be a boolean", "invalid_request_error")
            return

        entry = read_auth(self.auth_file_path)
        if not entry:
            self._send_error(401, "Not authenticated — run 'xgroxy login' first",
                             "authentication_error")
            return

        # Proactive refresh
        if _needs_proactive_refresh(entry) and entry.get("refresh_token"):
            try:
                entry = refresh_token(entry, self.auth_file_path)
            except Exception:
                pass

        token = entry.get("key", "")
        if not token:
            self._send_error(401, "No access token", "authentication_error")
            return

        is_stream = body.get("stream", False)

        if is_stream:
            self._handle_stream(body, token, entry)
        else:
            self._handle_nonstream(body, token, entry)

    def _handle_nonstream(self, body: dict, token: str, entry: dict):
        """Handle a non-streaming chat request with reactive refresh."""
        forward = _forward_fields(body, self.default_model)
        status, upstream, headers = _upstream_request(forward, token)

        # Reactive refresh on 401
        if status == 401 and entry.get("refresh_token"):
            try:
                entry = refresh_token(entry, self.auth_file_path, force=True)
                token = entry.get("key", "")
                status, upstream, headers = _upstream_request(forward, token)
            except Exception:
                pass

        if status == 401:
            self._send_error(401, "Token expired — run 'xgroxy login' to re-authenticate",
                             "authentication_error", "token_expired")
            return
        elif status == 429:
            msg = upstream.get("error", {}).get("message", "Rate limited") if isinstance(upstream, dict) else str(upstream)
            retry = headers.get("Retry-After", "")
            self._send_error(429, msg, "rate_limit_error", "429", extra_headers={
                "Retry-After": retry} if retry else None)
            return
        elif status >= 400:
            msg = _extract_error_message(upstream)
            self._send_error(status, msg, "upstream_error", str(status))
            return

        self._send_json(status, upstream)

    def _handle_stream(self, body: dict, token: str, entry: dict):
        stream_options = body.get("stream_options")
        include_usage = (
            isinstance(stream_options, dict)
            and stream_options.get("include_usage", False)
        )

        forward = _forward_fields(body, self.default_model)
        try:
            resp = self._open_upstream_stream(forward, token)
        except urllib.error.HTTPError as first_error:
            if first_error.code == 401 and entry.get("refresh_token"):
                first_error.close()
                try:
                    entry = refresh_token(entry, self.auth_file_path, force=True)
                    resp = self._open_upstream_stream(forward, entry.get("key", ""))
                except urllib.error.HTTPError as retry_error:
                    self._send_upstream_http_error(retry_error)
                    return
                except (urllib.error.URLError, TimeoutError, OSError) as e:
                    self._send_connection_error(e)
                    return
                except Exception as e:
                    self._send_error(401, f"Token refresh failed: {e}",
                                     "authentication_error", "token_expired")
                    return
            else:
                self._send_upstream_http_error(first_error)
                return
        except (urllib.error.URLError, TimeoutError, OSError) as e:
            self._send_connection_error(e)
            return

        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream")
        self.send_header("Cache-Control", "no-cache")
        # BaseHTTPRequestHandler does not add HTTP/1.1 chunk framing. Close the
        # connection after [DONE] so clients can reliably detect the SSE end.
        self.send_header("Connection", "close")
        self.close_connection = True
        self.send_header("X-Accel-Buffering", "no")
        self._cors_headers()
        self.end_headers()

        try:
            self._relay_stream(resp, include_usage)
        except (ConnectionError, BrokenPipeError, OSError):
            # Client disconnected
            pass
        finally:
            resp.close()

    @staticmethod
    def _open_upstream_stream(forward: dict, token: str):
        data = json.dumps(forward).encode("utf-8")
        req = urllib.request.Request(UPSTREAM_CHAT_URL, data=data, method="POST")
        req.add_header("Content-Type", "application/json")
        req.add_header("Authorization", f"Bearer {token}")
        return urllib.request.urlopen(req, timeout=300)

    def _send_upstream_http_error(self, error: urllib.error.HTTPError):
        try:
            raw = error.read().decode("utf-8", errors="replace")
            try:
                payload = json.loads(raw)
            except json.JSONDecodeError:
                payload = {"error": {"message": raw or error.reason}}
            message = _extract_error_message(payload)
            err_type = "authentication_error" if error.code == 401 else "upstream_error"
            self._send_error(error.code, message, err_type, str(error.code))
        finally:
            error.close()

    def _send_connection_error(self, error: Exception):
        reason = getattr(error, "reason", error)
        self._send_error(502, f"Could not connect to xAI: {reason}", "upstream_error", "502")

    def _relay_stream(self, resp, include_usage: bool):
        """Relay complete SSE lines immediately instead of buffering 4 KiB."""
        try:
            for raw_line in resp:
                line = raw_line.strip()
                if not line or not line.startswith(b"data:"):
                    continue
                data_str = line[5:].lstrip().decode("utf-8", errors="replace")
                if data_str == "[DONE]":
                    self.wfile.write(b"data: [DONE]\n\n")
                    return
                try:
                    event = json.loads(data_str)
                except json.JSONDecodeError:
                    continue
                rewritten = _rewrite_sse_chunk(event, include_usage)
                if rewritten:
                    self.wfile.write(rewritten)

            # Always send DONE at end if not already sent
            self.wfile.write(b"data: [DONE]\n\n")
        except (BrokenPipeError, ConnectionError, OSError):
            pass


class _ThreadedServer(ThreadingMixIn, http.server.HTTPServer):
    allow_reuse_address = True
    daemon_threads = True


# --- CLI: serve ---


def cmd_serve(args: argparse.Namespace) -> None:
    entry = read_auth(args.auth_file)
    path = _auth_file_path(args.auth_file)
    if not entry:
        print(f"WARNING: No auth file at {path}. Server will start but requests will fail.",
              file=sys.stderr)

    api_key = args.api_key or os.environ.get("XGROXY_API_KEY")
    model = args.model or DEFAULT_MODEL
    if args.host not in ("127.0.0.1", "::1", "localhost") and not api_key:
        print("WARNING: non-loopback host without --api-key exposes the proxy to the network.",
              file=sys.stderr)

    _Handler.api_key = api_key
    _Handler.auth_file_path = args.auth_file
    _Handler.default_model = model

    try:
        server = _ThreadedServer((args.host, args.port), _Handler)
    except (OSError, OverflowError) as e:
        print(f"Could not listen on {args.host}:{args.port}: {e}", file=sys.stderr)
        sys.exit(1)
    email = entry.get("email", "not authenticated")
    expires = entry.get("expires_at", "N/A")

    print(f"xgroxy {__version__} — Grok on http://{args.host}:{args.port}", flush=True)
    print(f"signed in as {email} · token exp {expires}", flush=True)
    print(f"model {model}" + (" · API key required" if api_key else ""), flush=True)
    print(flush=True)

    def _shutdown(sig, frame):
        print("\nShutting down...")
        # HTTPServer.shutdown() waits for serve_forever(), so calling it in the
        # main thread's signal handler deadlocks. Let a helper thread do it.
        threading.Thread(target=server.shutdown, daemon=True).start()

    signal.signal(signal.SIGINT, _shutdown)
    signal.signal(signal.SIGTERM, _shutdown)

    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()


# --- Main ---


def main() -> None:
    parser = argparse.ArgumentParser(
        prog="xgroxy",
        description="X Premium+ / SuperGrok → local OpenAI-compatible API",
    )
    parser.add_argument("--version", action="version", version=f"xgroxy {__version__}")

    sub = parser.add_subparsers(dest="command")

    def port_number(value: str) -> int:
        try:
            port = int(value)
        except ValueError as e:
            raise argparse.ArgumentTypeError("port must be an integer") from e
        if not 1 <= port <= 65535:
            raise argparse.ArgumentTypeError("port must be between 1 and 65535")
        return port

    # login
    p_login = sub.add_parser("login", help="Run device-flow login")
    p_login.add_argument("--auth-file", help="Path to auth.json")

    # serve
    p_serve = sub.add_parser("serve", help="Start HTTP server")
    p_serve.add_argument("--host", default="127.0.0.1")
    p_serve.add_argument("--port", type=port_number, default=8788)
    p_serve.add_argument("--api-key", help="Require Bearer token on local endpoint")
    p_serve.add_argument("--auth-file", help="Path to auth.json")
    p_serve.add_argument("--model", default=DEFAULT_MODEL, help="Default model name")

    # status
    p_status = sub.add_parser("status", help="Show auth status")
    p_status.add_argument("--auth-file", help="Path to auth.json")

    # token
    p_token = sub.add_parser("token", help="Print access token")
    p_token.add_argument("--auth-file", help="Path to auth.json")

    # install-service / uninstall-service
    p_inst = sub.add_parser(
        "install-service",
        help="Install + enable a systemd user service (starts at login)",
    )
    p_inst.add_argument("--host", default="127.0.0.1")
    p_inst.add_argument("--port", type=port_number, default=8788)
    p_inst.add_argument("--api-key", help="Require Bearer token on local endpoint")
    p_inst.add_argument("--auth-file", help="Path to auth.json")
    p_inst.add_argument("--model", default=DEFAULT_MODEL, help="Default model name")
    p_inst.add_argument(
        "--linger",
        action="store_true",
        help="Also run loginctl enable-linger (keep service after logout)",
    )
    p_uninst = sub.add_parser(
        "uninstall-service",
        help="Stop and remove the systemd user service",
    )

    args = parser.parse_args()

    try:
        if args.command == "login":
            cmd_login(args)
        elif args.command == "serve":
            cmd_serve(args)
        elif args.command == "status":
            cmd_status(args)
        elif args.command == "token":
            cmd_token(args)
        elif args.command == "install-service":
            cmd_install_service(args)
        elif args.command == "uninstall-service":
            cmd_uninstall_service(args)
        else:
            parser.print_help()
            sys.exit(1)
    except KeyboardInterrupt:
        print("\nCancelled.", file=sys.stderr)
        sys.exit(130)
    except (RuntimeError, OSError) as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
