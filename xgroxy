# --- Auth file helpers ---


def _auth_file_path(explicit: str | None = None) -> Path:
    if explicit:
        return Path(explicit)
    env = os.environ.get("XGROXY_AUTH_FILE")
    if env:
        return Path(env)
    grok_cli = Path.home() / ".grok" / "auth.json"
    if grok_cli.exists():
        return grok_cli
    return Path.home() / ".xgroxy" / "auth.json"


def read_auth(explicit: str | None = None) -> dict:
    path = _auth_file_path(explicit)
    if not path.exists():
        return {}
    try:
        with open(path, "r", encoding="utf-8") as f:
            data = json.load(f)
    except (json.JSONDecodeError, OSError):
        return {}

    if isinstance(data, dict) and data:
        entry = data.get(list(data.keys())[0])
        if isinstance(entry, dict):
            entry["_auth_path"] = str(path)
            entry["_scope_key"] = list(data.keys())[0]
            return entry
    return {}


def write_auth(entry: dict, explicit: str | None = None) -> None:
    path = _auth_file_path(explicit)
    scope_key = entry.pop("_scope_key", CLIENT_ID_SCOPE_KEY)
    entry.pop("_auth_path", None)
    data = {scope_key: entry}

    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2)
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)


CLIENT_ID_SCOPE_KEY = f"{OAUTH_ISSUER}::{CLIENT_ID}"


def _http_form_post(url: str, fields: dict, headers: dict | None = None) -> dict:
    data = urllib.parse.urlencode(fields).encode("utf-8")
    req = urllib.request.Request(url, data=data, method="POST")
    req.add_header("Content-Type", "application/x-www-form-urlencoded")
    if headers:
        for k, v in headers.items():
            req.add_header(k, v)
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as e:
        body = e.read().decode("utf-8", errors="replace")
        try:
            return json.loads(body)
        except json.JSONDecodeError:
            raise RuntimeError(f"HTTP {e.code}: {body}") from e


def _http_get(url: str, token: str) -> dict:
    req = urllib.request.Request(url)
    req.add_header("Authorization", f"Bearer {token}")
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as e:
        body = e.read().decode("utf-8", errors="replace")
        try:
            return json.loads(body)
        except json.JSONDecodeError:
            raise RuntimeError(f"HTTP {e.code}: {body}") from e


def _parse_expiry(expires_at: str) -> float:
    """Parse ISO timestamp to epoch seconds (UTC)."""
    try:
        dt = datetime.fromisoformat(expires_at.replace("Z", "+00:00"))
        return dt.timestamp()
    except Exception:
        return 0.0


# --- Token refresh ---

_refresh_lock = threading.Lock()


def _needs_proactive_refresh(entry: dict) -> bool:
    expires_at = entry.get("expires_at", "")
    ts = _parse_expiry(expires_at)
    if ts == 0:
        return False
    return (ts - time.time()) < 5400  # 90 minutes


def refresh_token(entry: dict, explicit_path: str | None = None, force: bool = False) -> dict:
    """Refresh the access token. Set force=True for reactive (401) refreshes."""
    with _refresh_lock:
        # For proactive refreshes, double-check after acquiring lock
        if not force and not _needs_proactive_refresh(entry):
            return entry
        refresh = entry.get("refresh_token", "")
        if not refresh:
            raise RuntimeError("No refresh token available — run xgroxy login")

        resp = _http_form_post(TOKEN_URL, {
            "grant_type": "refresh_token",
            "refresh_token": refresh,
            "client_id": CLIENT_ID,
        })

        new_access = resp.get("access_token")
        if not new_access:
            raise RuntimeError(f"Token refresh failed: {resp}")

        new_expires_in = resp.get("expires_in", 21600)
        new_expires_at = datetime.now(timezone.utc).timestamp() + new_expires_in
        expires_z = datetime.fromtimestamp(new_expires_at, tz=timezone.utc).strftime(
            "%Y-%m-%dT%H:%M:%S.000Z"
        )

        entry["key"] = new_access
        entry["expires_at"] = expires_z
        if resp.get("refresh_token"):
            entry["refresh_token"] = resp["refresh_token"]

        write_auth(entry, explicit_path)
        return entry


# --- CLI: login ---


def cmd_login(args: argparse.Namespace) -> None:
    auth_path = args.auth_file
    print("Starting device flow login...")
    print(f"Auth file: {_auth_file_path(auth_path)}")

    # Step 1: get device code
    resp = _http_form_post(DEVICE_CODE_URL, {
        "client_id": CLIENT_ID,
        "scope": SCOPE,
    })

    device_code = resp.get("device_code")
    user_code = resp.get("user_code")
    verification_uri = resp.get("verification_uri", VERIFICATION_PAGE)
    verification_uri_complete = resp.get("verification_uri_complete", "")
    interval = int(resp.get("interval", 5))
    expires_in = int(resp.get("expires_in", 1800))

    if not device_code or not user_code:
        print(f"Error: unexpected response from device code endpoint: {resp}", file=sys.stderr)
        sys.exit(1)

    print()
    print("  1. Open this URL in your browser (must be logged into your X account):")
    if verification_uri_complete:
        print(f"     {verification_uri_complete}")
    else:
        print(f"     {verification_uri}")
    print()
    print(f"  2. Enter code:  {user_code}")
    print("     Waiting for authorization...")
    print(flush=True)

    # Step 2: poll for token
    deadline = time.time() + expires_in
    while time.time() < deadline:
        time.sleep(interval)

        try:
            token_resp = _http_form_post(TOKEN_URL, {
                "grant_type": "urn:ietf:params:oauth:grant-type:device_code",
                "device_code": device_code,
                "client_id": CLIENT_ID,
            })
        except RuntimeError as e:
            print(f"Token request error: {e}", file=sys.stderr, flush=True)
            continue

        error = token_resp.get("error")
        if error == "authorization_pending":
            continue
        elif error == "slow_down":
            interval += 5
            continue
        elif error in ("access_denied", "expired_token"):
            print(f"Login failed: {error}", file=sys.stderr, flush=True)
            sys.exit(1)

        access_token = token_resp.get("access_token")
        if access_token:
            refresh_tok = token_resp.get("refresh_token", "")
            expires_in_val = token_resp.get("expires_in", 21600)
            expires_at_ts = datetime.now(timezone.utc).timestamp() + expires_in_val
            expires_at_str = datetime.fromtimestamp(
                expires_at_ts, tz=timezone.utc
            ).strftime("%Y-%m-%dT%H:%M:%S.000Z")

            email = ""
            first_name = ""
            user_id = ""
            # Best-effort userinfo fetch
            try:
                userinfo = _http_get(USERINFO_URL, access_token)
                email = userinfo.get("email", "")
                first_name = userinfo.get("given_name", userinfo.get("first_name", ""))
                user_id = userinfo.get("sub", "")
            except Exception:
                pass

            entry = {
                "key": access_token,
                "auth_mode": "oidc",
                "refresh_token": refresh_tok,
                "expires_at": expires_at_str,
                "oidc_issuer": OAUTH_ISSUER,
                "oidc_client_id": CLIENT_ID,
                "email": email,
                "user_id": user_id,
                "first_name": first_name,
                "_scope_key": CLIENT_ID_SCOPE_KEY,
                "_auth_path": str(_auth_file_path(auth_path)),
            }
            write_auth(entry, auth_path)
            print(f"Login successful! Email: {email or 'unknown'}", flush=True)
            return

    print("Login timed out waiting for authorization.", file=sys.stderr, flush=True)
    sys.exit(1)


