def _require_auth(args: argparse.Namespace) -> dict:
    entry = read_auth(args.auth_file)
    if not entry:
        path = _auth_file_path(args.auth_file)
        print(f"No auth file found at {path}. Run 'xgroxy login'.", file=sys.stderr)
        sys.exit(1)
    return entry


def cmd_status(args: argparse.Namespace) -> None:
    entry = _require_auth(args)
    path = _auth_file_path(args.auth_file)
    email = entry.get("email", "unknown")
    expires = entry.get("expires_at", "unknown")
    print(f"Auth file: {path}")
