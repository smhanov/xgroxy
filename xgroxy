def _require_auth(args: argparse.Namespace) -> dict:
    entry = read_auth(args.auth_file)
    if not entry:
        path = _auth_file_path(args.auth_file)
        detail = "No usable authentication found" if path.exists() else "No auth file found"
        print(f"{detail} at {path}. Run 'xgroxy login'.", file=sys.stderr)
